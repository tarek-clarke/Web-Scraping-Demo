ARG ROCM_VERSION=6.0
ARG UBUNTU_VERSION=22.04
ARG PYTORCH_VERSION=2.1.1

FROM rocm/pytorch:rocm${ROCM_VERSION}_ubuntu${UBUNTU_VERSION}_py3.10_pytorch_${PYTORCH_VERSION} as builder

ARG ROCM_VERSION=6.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-venv \
    golang-go \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-base.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-base.txt

RUN if [ "$ROCM_VERSION" = "6.0" ]; then \
        pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/rocm6.0; \
    elif [ "$ROCM_VERSION" = "6.1" ]; then \
        pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/rocm6.1; \
    elif [ "$ROCM_VERSION" = "6.2" ]; then \
        pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/rocm6.1; \
    else \
        pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/rocm6.0; \
    fi

FROM rocm/pytorch:rocm${ROCM_VERSION}_ubuntu${UBUNTU_VERSION}_py3.10_pytorch_${PYTORCH_VERSION}

ARG ROCM_VERSION=6.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y \
    golang-go \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

COPY . .

RUN cd go/ingestion && go mod download

RUN mkdir -p /app/models /app/data/ingested /app/data/chaos_log /app/data/reports

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import torch; print('ROCm available:', torch.cuda.is_available()); print('HIP version:', torch.version.hip)" || exit 1

ENTRYPOINT ["python3"]
CMD ["run_matrix.py"]
