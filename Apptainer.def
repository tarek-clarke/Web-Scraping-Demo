# Apptainer / Singularity Definition File for Resilient RAP Framework
# Optimized for execution on EuroHPC heterogeneous cluster systems:
# NVIDIA (CUDA via TalTech amp node) and AMD Instinct MI250X (ROCm via LUMI-G)

Bootstrap: docker
From: rocm/dev-ubuntu-22.04:6.3.4-complete

%labels
    Maintainer MLOps_Engineer_Resilient_RAP
    Version 2.0.0
    Description Resilient RAP Data Engineering Container with Hardware-Native Energy and Carbon Profiling

%environment
    export LC_ALL=C
    export PATH=/opt/rocm/bin:/opt/rocm/opencl/bin:$PATH
    export LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:/usr/local/cuda/lib64:$LD_LIBRARY_PATH
    export PYTHONPATH=/workspace:$PYTHONPATH
    export HF_HOME=/workspace/hf_cache

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        wget \
        ca-certificates \
        python3-pip \
        python3-dev \
        pciutils \
        kmod \
        lm-sensors \
        && rm -rf /var/lib/apt/lists/*

    # Symlink python3 to python
    ln -s /usr/bin/python3 /usr/bin/python

    # Install CUDA NVML libraries for nvidia detection inside AMD base image
    # Note: NVML is provided by the host GPU driver at runtime via binding, but headers/wrappers are installed in Python
    pip install --no-cache-dir --upgrade pip setuptools wheel

    # Install core RAP framework dependencies
    pip install --no-cache-dir \
        numpy \
        pandas \
        scipy \
        scikit-learn \
        transformers \
        torch \
        codecarbon \
        pynvml \
        qiskit \
        qiskit-aer \
        Levenshtein

    # Create workspace directories
    mkdir -p /workspace/metrics /workspace/data /workspace/configs

%runscript
    exec python3 "$@"

%help
    Resilient RAP High-Performance Computing (HPC) Container.
    
    To execute benchmarks with hardware-native energy profiling and carbon tracking,
    ensure GPU device bindings are attached at runtime:
    
    NVIDIA / TalTech CUDA runs:
        apptainer run --nv --bind /sys:/sys,$(pwd):/workspace resilient-rap.sif run_matrix.py
        
    AMD / LUMI-G ROCm runs:
        apptainer run --rocm --bind /sys:/sys,$(pwd):/workspace resilient-rap.sif run_matrix.py
