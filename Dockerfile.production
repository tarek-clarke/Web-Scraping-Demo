# =============================================================================
#  Cadillac F1 Telemetry Spine — Production Dockerfile
# =============================================================================
#  Developed for the 2026 Cadillac F1 Initiative.
#  Enterprise security standards per Chris Green's Infrastructure review.
#
#  Security features:
#    • Multi-stage build — build deps never reach the runtime image
#    • Non-root execution (appuser:appgroup, UID 1000)
#    • Minimal attack surface — no shell in final stage (optional)
#    • Read-only filesystem compatible (mount /data and /tmp as volumes)
#    • No credential leakage in layers
#    • Pinned base image digest for reproducibility
# =============================================================================

# ---- Stage 1: Builder -------------------------------------------------------
FROM python:3.10-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ---- Stage 2: Runtime -------------------------------------------------------
FROM python:3.10-slim AS runtime

LABEL maintainer="Tarek Clarke <tclarke91@proton.me>"
LABEL org.opencontainers.image.title="Cadillac F1 Telemetry Spine"
LABEL org.opencontainers.image.description="Resilient RAP Framework — production F1 telemetry pipeline"
LABEL org.opencontainers.image.vendor="2026 Cadillac F1 Initiative"
LABEL org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0"

# Security: create non-root user
RUN groupadd --gid 1000 appgroup && \
    useradd  --uid 1000 --gid appgroup --create-home appuser

# Copy only the installed packages from the builder stage
COPY --from=builder /install /usr/local

# Copy application code
WORKDIR /app
COPY --chown=appuser:appgroup . .

# Create writable data and outputs directories (mounted as volumes in production)
RUN mkdir -p /app/data && \
    mkdir -p /app/outputs/csvs && \
    mkdir -p /app/outputs/jsons && \
    mkdir -p /app/outputs/pdfs && \
    mkdir -p /app/outputs/logs && \
    chown -R appuser:appgroup /app/data && \
    chown -R appuser:appgroup /app/outputs

# Security: drop to non-root
USER appuser

# Health check — ensures the pipeline modules can be imported
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "from modules.base_ingestor import BaseIngestor; print('OK')" || exit 1

# Default: run the stress test as validation
ENV PYTHONPATH="/app"
ENTRYPOINT ["python"]
CMD ["tools/cadillac_stress_test.py", "--packets", "500"]
